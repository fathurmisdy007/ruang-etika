Options -Indexes -ExecCGI

# Hanya gambar dengan nama acak buatan aplikasi yang boleh diakses.
<FilesMatch "^(?![a-f0-9]{32}\.(?:jpg|png|webp)$)">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .jpg .png .webp
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar
</IfModule>

<FilesMatch "\.(?:jpg|png|webp)$">
    SetHandler none
</FilesMatch>

<IfModule php_module>
    php_flag engine Off
</IfModule>
<IfModule mod_php.c>
    php_flag engine Off
</IfModule>
